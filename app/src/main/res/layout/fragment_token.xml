<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TOKEN DISCORD" android:textStyle="bold" android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Cole seu token de usuário Discord"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText android:id="@+id/et_token"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="textPassword"
            android:hint="OTA0MDA..."/>
        <Button android:id="@+id/btn_toggle_show"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Mostrar"
            style="@style/Widget.Material3.Button.TextButton"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp">
        <Button android:id="@+id/btn_save_token"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Salvar"
            android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btn_test_token"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Testar Token"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <ProgressBar android:id="@+id/progress_token"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"/>

    <TextView android:id="@+id/tv_token_result"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp" android:textStyle="bold"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Como obter seu token:\n1. Abra Discord no PC\n2. Ctrl+Shift+I → Aba Network\n3. Faça qualquer ação\n4. Busque 'Authorization' nos headers\n5. Copie o valor"
        android:textSize="12sp" android:textColor="#888888"/>

</LinearLayout>
